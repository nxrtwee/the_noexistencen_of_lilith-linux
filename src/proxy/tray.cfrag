/* Replace only SystemTray's OS backend; keep the original menu-building code and Action delegates. */
static CRITICAL_SECTION ll_tray_mutex;
static int ll_tray_enabled;
static uint32_t ll_tray_owner,ll_tray_actions[LL_TRAY_ITEMS],ll_tray_badge;
static uint32_t (*ll_gc_new)(void*,unsigned char);
static void (*ll_gc_free)(uint32_t);
static void *(*ll_gc_target)(uint32_t);
static void *(*ll_invoke)(void*,void*,void**,void**);
static void *(*ll_unbox)(void*),*(*ll_virtual)(void*,void*);
static void *(*ll_interfaces)(void*,void**),*(*ll_parent)(void*),*(*ll_fields)(void*,const char*);
static size_t (*ll_field_off)(void*);
static int (*ll_rank)(void*),(*ll_value_size)(void*,uint32_t*);
static void *(*ll_element)(void*);
static size_t (*ll_array_len)(void*);
static fn_cls ll_tray_cls;
static fn_meth ll_tray_meth;
static ll_tray *ll_tray_channel(void){return g_shm?(ll_tray*)((unsigned char*)g_shm+LL_TRAY_OFF):NULL;}
static void ll_tray_text(uint16_t *dst,unsigned cap,void *str) {
    int n=str?ll_managed_length(str):0;if(n<0)n=0;if(n>=(int)cap)n=cap-1;
    // Avoid truncating a surrogate pair in tooltip/labels.
    const uint16_t *s=str?ll_managed_chars(str):NULL;
    if(n && s[n-1]>=0xd800 && s[n-1]<=0xdbff)n--;
    ll_copy16(dst,cap,s,n);
}
static int ll_tray_begin(void *self) {
    EnterCriticalSection(&ll_tray_mutex);ll_tray *t=ll_tray_channel();
    if(!t || t->magic!=LL_TRAY_MAGIC || !ll_tray_owner || ll_gc_target(ll_tray_owner)!=self){LeaveCriticalSection(&ll_tray_mutex);return 0;}
    InterlockedIncrement((LONG*)&t->seq);MemoryBarrier();return 1;
}
static void ll_tray_end(void){MemoryBarrier();InterlockedIncrement((LONG*)&ll_tray_channel()->seq);LeaveCriticalSection(&ll_tray_mutex);}
static void ll_tray_release_actions(void) {
    for(int i=0;i<LL_TRAY_ITEMS;i++){if(ll_tray_actions[i])ll_gc_free(ll_tray_actions[i]);ll_tray_actions[i]=0;}
    if(ll_tray_badge)ll_gc_free(ll_tray_badge);ll_tray_badge=0;
}
static void ll_tray_path(uint16_t *dst,void *path) {
    uint16_t in[LL_TRAY_PATH];dst[0]=0;
    if(path && ll_managed_copy(in,LL_TRAY_PATH,path))ll_desktop_to_unix(dst,in);
}
static void ll_tray_ctor(void *self,void *icon,void *method) {
    (void)method;EnterCriticalSection(&ll_tray_mutex);ll_tray *t=ll_tray_channel();
    if(!t || t->magic!=LL_TRAY_MAGIC){LeaveCriticalSection(&ll_tray_mutex);return;}
    InterlockedIncrement((LONG*)&t->seq);MemoryBarrier();
    ll_tray_release_actions();if(ll_tray_owner)ll_gc_free(ll_tray_owner);ll_tray_owner=ll_gc_new(self,0);
    uint32_t generation=t->snapshot.generation+1;if(!generation)generation=1;
    __builtin_memset(&t->snapshot,0,sizeof(t->snapshot));t->snapshot.generation=generation;t->snapshot.active=1;
    ll_tray_path(t->snapshot.icon,icon);const char *title="Lilith";for(int i=0;title[i];i++)t->snapshot.title[i]=title[i];
    MemoryBarrier();InterlockedIncrement((LONG*)&t->seq);LeaveCriticalSection(&ll_tray_mutex);
    logf("native tray created generation=%u",generation);
}
static uint32_t ll_tray_append(uint32_t parent,uint32_t kind,void *label,void *action) {
    ll_tray_snapshot *s=&ll_tray_channel()->snapshot;if(s->count>=LL_TRAY_ITEMS){logf("ERROR native tray menu capacity reached");return 0;}
    uint32_t index=s->count++;ll_tray_item *item=&s->items[index];__builtin_memset(item,0,sizeof(*item));
    item->id=index+1;item->parent=parent;item->kind=kind;item->enabled=kind==1 || action!=NULL;
    ll_tray_text(item->label,LL_TRAY_LABEL,label);if(action)ll_tray_actions[index]=ll_gc_new(action,0);return item->id;
}
static void ll_tray_item_add(void *self,void *label,void *action,void *m){(void)m;if(!ll_tray_begin(self))return;ll_tray_append(0,0,label,action);ll_tray_end();}
static void ll_tray_separator(void *self,void *m){(void)m;if(!ll_tray_begin(self))return;ll_tray_append(0,2,NULL,NULL);ll_tray_end();}
static void ll_tray_title(void *self,void *label,void *m){(void)m;if(!ll_tray_begin(self))return;ll_tray_text(ll_tray_channel()->snapshot.title,LL_TRAY_LABEL,label);ll_tray_end();}
static void ll_tray_icon(void *self,void *path,void *m){(void)m;if(!ll_tray_begin(self))return;ll_tray_path(ll_tray_channel()->snapshot.icon,path);ll_tray_end();}
static void ll_tray_badge_show(void *self,void *path,void *tip,void *action,void *m) {
    (void)m;if(!ll_tray_begin(self))return;ll_tray_snapshot *s=&ll_tray_channel()->snapshot;
    if(ll_tray_badge)ll_gc_free(ll_tray_badge);ll_tray_badge=action?ll_gc_new(action,0):0;
    s->badge_visible=1;ll_tray_path(s->badge_icon,path);ll_tray_text(s->badge_tip,LL_TRAY_LABEL,tip);ll_tray_end();
}
static void ll_tray_badge_hide(void *self,void *m) {
    (void)m;if(!ll_tray_begin(self))return;ll_tray_channel()->snapshot.badge_visible=0;
    if(ll_tray_badge)ll_gc_free(ll_tray_badge);ll_tray_badge=0;ll_tray_end();
}
static void ll_tray_dispose(void *self,void *m) {
    (void)m;if(!ll_tray_begin(self))return;ll_tray_snapshot *s=&ll_tray_channel()->snapshot;s->active=0;s->badge_visible=0;s->count=0;
    ll_tray_release_actions();ll_gc_free(ll_tray_owner);ll_tray_owner=0;ll_tray_end();logf("native tray disposed");
}
static void ll_tray_notify(void *self,void *title,void *text,int duration,void *m) {
    (void)m;EnterCriticalSection(&ll_tray_mutex);ll_tray *t=ll_tray_channel();
    if(!t || !ll_tray_owner || ll_gc_target(ll_tray_owner)!=self){LeaveCriticalSection(&ll_tray_mutex);return;}
    for(int i=0;i<LL_TRAY_NOTIFICATIONS;i++) {
        ll_tray_notification *n=&t->notifications[i];if(InterlockedCompareExchange((LONG*)&n->state,1,0)!=0)continue;
        n->generation=t->snapshot.generation;n->duration=duration<1000?1000:duration>30000?30000:duration;
        ll_tray_text(n->title,LL_TRAY_LABEL,title);ll_tray_text(n->text,1024,text);
        MemoryBarrier();InterlockedExchange((LONG*)&n->state,2);LeaveCriticalSection(&ll_tray_mutex);return;
    }
    LeaveCriticalSection(&ll_tray_mutex);logf("native tray notification queue full");
}
static void *ll_tray_lookup(void *klass,const char *name,int argc,int depth) {
    if(!klass || depth>5)return NULL;void *m=ll_tray_meth(klass,name,argc);if(m)return m;
    void *iter=NULL,*iface;while((iface=ll_interfaces(klass,&iter))) {m=ll_tray_lookup(iface,name,argc,depth+1);if(m)return m;}
    return ll_tray_lookup(ll_parent(klass),name,argc,depth+1);
}
static void *ll_tray_call(void *obj,const char *name,int argc,void **args) {
    void *mi=ll_tray_lookup(ll_object_class(obj),name,argc,0);if(!mi)return NULL;
    void *virt=ll_virtual(obj,mi);if(virt)mi=virt;void *exception=NULL,*out=ll_invoke(mi,obj,args,&exception);
    if(exception){logf("ERROR native tray managed collection call %s",name);return NULL;}return out;
}
static int ll_tray_tuples(void *list,void **array,void **element,int *count) {
    void *klass=ll_object_class(list);*array=NULL;*element=NULL;*count=0;
    if(ll_rank(klass)>0){*array=list;*count=(int)ll_array_len(list);*element=ll_element(klass);return 1;}
    // Validate List<T> fields using metadata; no guessed collection offsets.
    void *items=ll_fields(klass,"_items"),*size=ll_fields(klass,"_size");
    if(items && size) {
        *array=*(void**)((unsigned char*)list+ll_field_off(items));*count=*(int*)((unsigned char*)list+ll_field_off(size));
        if(*array){*element=ll_element(ll_object_class(*array));if(*count<0 || (size_t)*count>ll_array_len(*array))return 0;return 1;}
        return *count==0;
    }
    return 0;
}
static void ll_tray_submenu(void *self,void *label,void *list,void *m) {
    (void)m;if(!ll_tray_begin(self))return;uint32_t parent=ll_tray_append(0,1,label,NULL);int added=0;
    if(list && parent) {
        void *array=NULL,*element=NULL;int count=0;uint32_t align=0;
        if(ll_tray_tuples(list,&array,&element,&count) && count>=0 && count<=1024 && (!count || (element && ll_value_size(element,&align)==16))) {
            void *f1=element?ll_fields(element,"Item1"):NULL,*f2=element?ll_fields(element,"Item2"):NULL;
            // Value-type field offsets include the boxed object header.
            if(!count || (f1 && f2 && ll_field_off(f1)==16 && ll_field_off(f2)==24)) {
                void **data=array?(void**)((unsigned char*)array+4*sizeof(void*)):NULL;
                for(int i=0;i<count && ll_tray_channel()->snapshot.count<LL_TRAY_ITEMS;i++){ll_tray_append(parent,0,data[i*2],data[i*2+1]);added++;}
            } else logf("ERROR native tray tuple layout mismatch");
        } else {
            void *boxed=ll_tray_call(list,"get_Count",0,NULL);int n=boxed?*(int*)ll_unbox(boxed):-1;
            for(int i=0;i<n && i<LL_TRAY_ITEMS;i++) {
                void *args[]={&i};void *item=ll_tray_call(list,"get_Item",1,args);if(!item)break;
                void *ec=ll_object_class(item),*f1=ll_fields(ec,"Item1"),*f2=ll_fields(ec,"Item2");
                if(!f1 || !f2 || ll_value_size(ec,&align)!=16 || ll_field_off(f1)!=16 || ll_field_off(f2)!=24)break;
                void **data=ll_unbox(item);ll_tray_append(parent,0,data[0],data[1]);added++;
            }
        }
    }
    logf("native tray submenu parent=%u entries=%d",parent,added);ll_tray_end();
}
static void ll_tray_noop(void *self,void *m){(void)self;(void)m;}
static void ll_tray_static_noop(void *m){(void)m;}
static int ll_tray_zero(void *m){(void)m;return 0;}
static void ll_tray_pump(int host_ok) {
    if(!ll_tray_enabled)return;ll_tray *t=ll_tray_channel();if(!t || t->magic!=LL_TRAY_MAGIC)return;
    uint32_t r=t->event_read,w=t->event_write;if(w-r>LL_TRAY_EVENTS){t->event_read=w;logf("ERROR native tray event ring overflow");return;}
    for(int n=0;r!=w && n<8;n++,r++) {
        MemoryBarrier();ll_tray_event e=t->events[r%LL_TRAY_EVENTS];uint32_t root=0;
        EnterCriticalSection(&ll_tray_mutex);
        if(host_ok && t->host_status==1 && t->snapshot.active && e.generation==t->snapshot.generation) {
            uint32_t handle=e.id==LL_TRAY_BADGE_ID?ll_tray_badge:(e.id>0 && e.id<=t->snapshot.count?ll_tray_actions[e.id-1]:0);
            void *action=handle?ll_gc_target(handle):NULL;if(action)root=ll_gc_new(action,0);
        }
        LeaveCriticalSection(&ll_tray_mutex);
        // Consume BEFORE invocation. A Quit action can stop the frame pump immediately.
        MemoryBarrier();t->event_read=r+1;
        if(root){void *action=ll_gc_target(root),*mi=ll_tray_meth(ll_object_class(action),"Invoke",0),*ex=NULL;
            if(mi){ll_invoke(mi,action,NULL,&ex);logf("native tray action id=%u generation=%u success=%d",e.id,e.generation,!ex);}
            else logf("ERROR native tray Action.Invoke unavailable");ll_gc_free(root);}
    }
}
static void ll_install_tray(HMODULE ga,void *img,fn_cls cls,fn_meth meth) {
    char env[8]={0};GetEnvironmentVariableA("LILITH_LINUX_TRAY",env,sizeof(env));if(env[0]=='0')return;
    // Tray can be independently enabled while native file dialogs are opted out.
    ll_managed_length=(void*)GetProcAddress(ga,"il2cpp_string_length");ll_managed_chars=(void*)GetProcAddress(ga,"il2cpp_string_chars");
    if(!ll_wine_unix)ll_wine_unix=(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"),"wine_get_unix_file_name");
    ll_gc_new=(void*)GetProcAddress(ga,"il2cpp_gchandle_new");ll_gc_free=(void*)GetProcAddress(ga,"il2cpp_gchandle_free");ll_gc_target=(void*)GetProcAddress(ga,"il2cpp_gchandle_get_target");
    ll_invoke=(void*)GetProcAddress(ga,"il2cpp_runtime_invoke");ll_unbox=(void*)GetProcAddress(ga,"il2cpp_object_unbox");ll_virtual=(void*)GetProcAddress(ga,"il2cpp_object_get_virtual_method");
    ll_interfaces=(void*)GetProcAddress(ga,"il2cpp_class_get_interfaces");ll_parent=(void*)GetProcAddress(ga,"il2cpp_class_get_parent");
    ll_fields=(void*)GetProcAddress(ga,"il2cpp_class_get_field_from_name");ll_field_off=(void*)GetProcAddress(ga,"il2cpp_field_get_offset");
    ll_rank=(void*)GetProcAddress(ga,"il2cpp_class_get_rank");ll_element=(void*)GetProcAddress(ga,"il2cpp_class_get_element_class");
    ll_array_len=(void*)GetProcAddress(ga,"il2cpp_array_length");ll_value_size=(void*)GetProcAddress(ga,"il2cpp_class_value_size");
    if(!ll_gc_new||!ll_gc_free||!ll_gc_target||!ll_invoke||!ll_unbox||!ll_virtual||!ll_interfaces||!ll_parent||!ll_fields||!ll_field_off||!ll_rank||!ll_element||!ll_array_len||!ll_value_size||!ll_managed_length||!ll_managed_chars||!ll_wine_unix||!ll_object_class){logf("ERROR native tray prerequisites missing");return;}
    ll_tray_cls=cls;ll_tray_meth=meth;InitializeCriticalSection(&ll_tray_mutex);
    // Preflight every target before altering the backend: no partial fallback to a Wine menu.
    const char *names[]={".cctor",".ctor","SetTrayIcon","SetTitle","AddItem","AddSubMenu","AddSeparator","ShowNotification","ShowNoteBadge","HideNoteBadge","Tick","Dispose","get_PendingShellCalls","get_SlowShellCalls"};
    int argc[]={0,1,1,1,2,2,0,3,3,0,0,0,0,0};
    void *repl[]={(void*)ll_tray_static_noop,(void*)ll_tray_ctor,(void*)ll_tray_icon,(void*)ll_tray_title,(void*)ll_tray_item_add,(void*)ll_tray_submenu,(void*)ll_tray_separator,(void*)ll_tray_notify,(void*)ll_tray_badge_show,(void*)ll_tray_badge_hide,(void*)ll_tray_noop,(void*)ll_tray_dispose,(void*)ll_tray_zero,(void*)ll_tray_zero};
    for(int i=0;i<14;i++)if(!ll_method(cls,meth,img,"","SystemTray",names[i],argc[i])){logf("ERROR native tray method unavailable %s",names[i]);return;}
    ll_tray_enabled=1;
    for(int i=0;i<14;i++)ll_hook_method(cls,meth,img,"","SystemTray",names[i],argc[i],repl[i]);
    logf("native tray backend installed; original menu delegates retained");
}
