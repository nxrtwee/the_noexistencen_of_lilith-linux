}
static unsigned char ll_native_player_open(void *m){return ll_native_player_open_out(NULL,m);}
static void ll_native_player_playpause(void *m){(void)m;ll_native_post(3,0,ll_native_default_player?ll_native_default_player(NULL):NULL);}
