    ll_hook_method(cls,meth,img,"","ClipboardFiles","TryClear",0,(void*)ll_native_clip_clear);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","SetEnabled",1,(void*)ll_native_paste_enable);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","SetOverCharacter",1,(void*)ll_native_paste_over);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","get_Installed",0,(void*)ll_native_paste_installed);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","ConsumePendingPasteRequest",0,(void*)ll_native_paste_consume);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","Uninstall",0,(void*)ll_native_paste_uninstall);
    ll_hook_method(cls,meth,img,"","ClipboardPasteHook","Install",0,(void*)ll_native_noop);
    ll_hook_method(cls,meth,img,"","FileDropReceiver","SyncHook",0,(void*)ll_native_noop);
