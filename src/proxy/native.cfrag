    EnterCriticalSection(&ll_native_mutex);uint32_t a=n->seq;MemoryBarrier();
    if(a&1){LeaveCriticalSection(&ll_native_mutex);return 0;}
    __builtin_memcpy(&ll_native_cache,&n->snapshot,sizeof(ll_native_cache));MemoryBarrier();
    int ok=a==n->seq && ll_native_cache.ready;LeaveCriticalSection(&ll_native_mutex);return ok;
}
static int ll_native_post(uint32_t kind,uint32_t value,void *target){
    ll_native *n=ll_native_channel();if(!n || n->magic!=LL_NATIVE_MAGIC)return 0;
    for(int i=0;i<8;i++){ll_native_command *c=&n->commands[i];if(InterlockedCompareExchange((LONG*)&c->state,1,0)!=0)continue;
        c->kind=kind;c->value=value;ll_tray_text(c->target,LL_NATIVE_TEXT,target);MemoryBarrier();InterlockedExchange((LONG*)&c->state,2);return 1;}
    logf("native services: command queue full");return 0;
}
