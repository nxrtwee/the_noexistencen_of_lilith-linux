static void ll_install_native(HMODULE ga,void *img,void *core,fn_cls cls,fn_meth meth){
    char env[8]={0};GetEnvironmentVariableA("LILITH_LINUX_NATIVE",env,sizeof(env));if(env[0]=='0')return;
    if(!ll_gc_new || !ll_invoke || !ll_managed_utf16 || !ll_wine_dos || !ll_array_new){logf("ERROR native parity prerequisites missing");return;}
    InitializeCriticalSection(&ll_native_mutex);
    void *corlib=ll_paths_image(ga,"mscorlib.dll");if(!corlib)corlib=ll_paths_image(ga,"mscorlib");
    ll_native_string_class=corlib?cls(corlib,"System","String"):NULL;ll_native_object_class=corlib?cls(corlib,"System","Object"):NULL;
    void *(*returntype)(void*)=(void*)GetProcAddress(ga,"il2cpp_method_get_return_type");void *(*fromtype)(void*)=(void*)GetProcAddress(ga,"il2cpp_class_from_type");
    void *player=cls(img,"","ExternalPlayerLauncher"),*players=player?meth(player,"get_Players",0):NULL;
    if(players && returntype && fromtype)ll_player_class=ll_element(fromtype(returntype(players)));uint32_t align=0;
    if(!ll_native_string_class || !ll_native_object_class || !ll_player_class || ll_value_size(ll_player_class,&align)!=80){logf("ERROR native managed type layouts unavailable");return;}
    ll_native_default_player=(void*)ll_method(cls,meth,img,"","ExternalPlayerLauncher","get_DefaultPlayerId",0);
    ll_native_opened=(void*)ll_method(cls,meth,img,"","ExternalPlayerLauncher","set_HasOpenedThisSession",1);
    ll_music_local_playing=(void*)ll_method(cls,meth,img,"","AudioManager","get_IsUserMusicPlaying",0);
    ll_music_local_paused=(void*)ll_method(cls,meth,img,"","AudioManager","get_IsUserMusicPaused",0);
    ll_music_panel_hide=(void*)ll_method(cls,meth,img,"","MusicPlayerController","OnTempHide",0);
    ll_music_panel_show=(void*)ll_method(cls,meth,img,"","MusicPlayerController","OnTempShow",0);
    void *panel=cls(img,"","MusicPlayerController"),*panelParent=panel?ll_parent(panel):NULL;
    ll_music_panel_instance=panelParent?ll_fields(panelParent,"s_instance"):NULL;
    ll_music_static_get=(void*)GetProcAddress(ga,"il2cpp_field_static_get_value");
    void *stop=ll_method(cls,meth,img,"","AudioManager","StopUserMusic",0);
    ll_music_stop_original=ll_native_stop_trampoline(stop);
    if(ll_music_stop_original && ll_music_local_playing && ll_music_local_paused && ll_music_panel_instance && ll_music_panel_hide && ll_music_panel_show && ll_music_static_get)ll_hook_method(cls,meth,img,"","AudioManager","StopUserMusic",0,(void*)ll_native_music_stop);
    else logf("ERROR native music stop/panel preflight failed; original method retained");
    ll_native_enqueue=(void*)ll_method(cls,meth,img,"","FileStashService","Enqueue",2);
    ll_native_hit=(void*)ll_method(cls,meth,img,"","TransparentWindowNew","IsPointOnCharacter",1);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","GetLaunchAtLoginEnabled",0,(void*)ll_native_startup_get);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","SetLaunchAtLoginEnabled",1,(void*)ll_native_startup_set);
    ll_hook_method(cls,meth,img,"","Win32Helper","GetStartup",0,(void*)ll_native_startup_static_get);
    ll_hook_method(cls,meth,img,"","Win32Helper","SetStartup",1,(void*)ll_native_startup_static_set);
    ll_hook_method(cls,meth,img,"","Win32Helper","RefreshStartupEntry",0,(void*)ll_native_noop);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","GetForegroundProcessName",0,(void*)ll_native_process);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","GetForegroundProcessDisplayName",0,(void*)ll_native_app);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","IsForegroundWindowFullscreen",0,(void*)ll_native_fullscreen);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","IsExclusiveFullscreenAppRunning",0,(void*)ll_native_fullscreen_static);
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","TryGetTimeSinceLastSystemInput",1,(void*)ll_native_idle);
    // KWin's supported idle API is aggregate input. Keyboard-only idle is conservatively bounded by it.
    ll_hook_method(cls,meth,img,"","WindowsPlatformService","TryGetTimeSinceLastKeyboardInput",1,(void*)ll_native_idle);
    ll_stash_tick=(void*)ll_method(cls,meth,img,"","FileStashService","Tick",0);
    ll_stash_pasted=(void*)ll_method(cls,meth,img,"","FileStashRunner","OnPasted",0);
    void *runner=cls(img,"","FileStashRunner"),*flag=runner?ll_fields(runner,"_clipboardHasFiles"):NULL;
