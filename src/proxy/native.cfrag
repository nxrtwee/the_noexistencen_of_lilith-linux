static void *ll_native_file_array(ll_native_files *batch){
    if(!batch->count || batch->count>LL_NATIVE_FILE_COUNT || !batch->units || batch->units>LL_NATIVE_FILE_UNITS)return NULL;
    for(uint32_t i=0;i<batch->count;i++){uint32_t p=batch->offsets[i],end=p;if(p>=batch->units)return NULL;while(end<batch->units && batch->paths[end])end++;if(end==batch->units || end-p>=4096 || batch->paths[p]!='/')return NULL;}
    void *array=ll_array_new(ll_native_string_class,batch->count);if(!array)return NULL;uint32_t root=ll_gc_new(array,0);
    for(uint32_t i=0;i<batch->count;i++){void *path=ll_desktop_to_managed(batch->paths+batch->offsets[i]);if(!path){ll_gc_free(root);return NULL;}array=ll_gc_target(root);void **items=(void**)((unsigned char*)array+4*sizeof(void*));ll_write_barrier(array,&items[i],path);}
    array=ll_gc_target(root);ll_gc_free(root);return array;
}
static unsigned char ll_native_clip_read(void **paths,unsigned char *cut,void *m){
    (void)m;if(paths)*paths=NULL;if(cut)*cut=0;ll_native *n=ll_native_channel();if(!n || !paths || !cut)return 0;
    ll_native_files *b=&n->clipboard;
    if(InterlockedCompareExchange((LONG*)&b->state,0,4)==4){} // discard a timed-out prior reply
    if(InterlockedCompareExchange((LONG*)&b->state,1,0)!=0)return 0;
    DWORD start=GetTickCount();while(GetTickCount()-start<1500){if(InterlockedCompareExchange((LONG*)&b->state,0,0)==4){MemoryBarrier();void *array=ll_native_file_array(b);*cut=b->cut!=0;if(array)ll_write_barrier(NULL,paths,array);InterlockedExchange((LONG*)&b->state,0);return array!=NULL;}Sleep(5);}
    InterlockedCompareExchange((LONG*)&b->state,0,1);return 0;
}
static unsigned char ll_native_clip_clear(void *m){(void)m;ll_native *n=ll_native_channel();if(!n || !n->clipboard_token)return 0;n->clipboard_clear=n->clipboard_token;return 1;}
static void ll_native_pump(int host_ok){
    if(!ll_native_enabled || !host_ok)return;ll_native *n=ll_native_channel();if(!n || n->magic!=LL_NATIVE_MAGIC)return;
    uint32_t probe=n->drop_probe_seq;MemoryBarrier();
    if(probe!=n->drop_probe_reply){ll_native_point point={(float)(n->drop_probe_x-g_lastPos.x),(float)(g_lastSize.cy-(n->drop_probe_y-g_lastPos.y))};n->drop_probe_hit=ll_native_hit && ll_native_hit(point,NULL);MemoryBarrier();n->drop_probe_reply=probe;}
    ll_native_hide_external_panel();
    ll_native_validate();
    static uint32_t resume=0;if(resume!=n->resume_serial){resume=n->resume_serial;logf("native services resumed; input state reset");}
    for(int i=0;i<2;i++){ll_native_files *b=&n->drops[i];if(InterlockedCompareExchange((LONG*)&b->state,3,2)!=2)continue;
        ll_native_point point={(float)(b->x-g_lastPos.x),(float)(g_lastSize.cy-(b->y-g_lastPos.y))};
        if(ll_native_hit && ll_native_enqueue && ll_native_hit(point,NULL)){void *array=ll_native_file_array(b);if(array){unsigned char accepted=ll_native_enqueue(array,b->copy!=0,NULL);logf("native file drop accepted=%d count=%u copy=%u",accepted,b->count,b->copy);}}
        InterlockedExchange((LONG*)&b->state,0);
    }
}
static void ll_native_stash_update(void *self,void *method){
    (void)method;if(ll_stash_tick)ll_stash_tick(NULL);ll_native *n=ll_native_channel();if(!n || !self)return;
    ll_native_point point={(float)(g_shm->mouse_x-g_lastPos.x),(float)(g_lastSize.cy-(g_shm->mouse_y-g_lastPos.y))};
    n->paste_enabled=1;n->paste_over=ll_native_hit && !(g_shm->game_flags&LL_PASSTHROUGH) && ll_native_hit(point,NULL);
    if(ll_clip_flag_offset)*(unsigned char*)((unsigned char*)self+ll_clip_flag_offset)=n->clipboard_has_files!=0;
    if(ll_native_paste_consume(NULL) && ll_stash_pasted)ll_stash_pasted(self,NULL);
