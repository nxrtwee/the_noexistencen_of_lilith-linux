static void ll_native_validate(void){
    static int done;static DWORD first;if(done)return;if(!first){first=GetTickCount();return;}if(GetTickCount()-first<5000 || !ll_native_read())return;done=1;
    void *array=ll_native_players(NULL);uint32_t root=array?ll_gc_new(array,0):0;
