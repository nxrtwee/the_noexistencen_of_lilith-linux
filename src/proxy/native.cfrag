    array=ll_gc_target(root);ll_gc_free(root);return array;
}
static void *ll_native_player_byid(void *result,void *id,void *m){
    (void)m;void *array=ll_native_players(NULL);__builtin_memset(result,0,80);if(!array)return result;
    uint32_t count=(uint32_t)ll_array_len(array),selected=0;void **data=(void**)((unsigned char*)array+4*sizeof(void*));
    if(id)for(uint32_t i=0;i<count;i++)if(!lstrcmpW((WCHAR*)ll_managed_chars(id),(WCHAR*)ll_managed_chars(data[i*10])))selected=i;
    __builtin_memcpy(result,data+selected*10,80);return result;
}
static void *ll_native_current_player(void *result,void *m){return ll_native_player_byid(result,ll_native_default_player?ll_native_default_player(NULL):NULL,m);}
