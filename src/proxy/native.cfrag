static void *ll_native_players(void *m){
    (void)m;ll_native_read();uint32_t count=ll_native_cache.player_count;if(count>LL_NATIVE_PLAYERS)count=LL_NATIVE_PLAYERS;if(!count)count=1;
    void *array=ll_array_new(ll_player_class,count);if(!array)return NULL;uint32_t root=ll_gc_new(array,0);
    for(uint32_t i=0;i<count;i++){
        uint16_t *id=ll_native_cache.players[i].id,*label=ll_native_cache.players[i].label;
        void *mid=ll_native_cache.player_count?ll_managed_utf16(id,lstrlenW((WCHAR*)id)):ll_string_new("linux.default");uint32_t ir=ll_gc_new(mid,0);
        void *name=ll_native_cache.player_count?ll_managed_utf16(label,lstrlenW((WCHAR*)label)):ll_string_new("Linux default player (MPRIS)");uint32_t nr=ll_gc_new(name,0);
        array=ll_gc_target(root);void **value=(void**)((unsigned char*)array+4*sizeof(void*)+i*80);
        ll_write_barrier(array,&value[0],ll_gc_target(ir));for(int j=1;j<=3;j++)ll_write_barrier(array,&value[j],ll_gc_target(nr));
        ll_gc_free(ir);ll_gc_free(nr);
