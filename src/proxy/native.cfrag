    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","BuildPlayers",0,(void*)ll_native_players);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","get_Players",0,(void*)ll_native_players);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","FindById",1,(void*)ll_native_player_byid);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","get_CurrentPlayer",0,(void*)ll_native_current_player);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","TryOpen",0,(void*)ll_native_player_open);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","TryOpen",1,(void*)ll_native_player_open_out);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","SendPlayPause",0,(void*)ll_native_player_playpause);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","SendNextTrack",0,(void*)ll_native_player_next);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","SendPrevTrack",0,(void*)ll_native_player_previous);
    ll_hook_method(cls,meth,img,"","ExternalPlayerLauncher","EnsurePlaybackRoutine",0,(void*)ll_native_empty_playback);
