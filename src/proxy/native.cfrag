static unsigned char ll_native_player_open_out(unsigned char *running,void *m){
    (void)m;ll_native_read();if(running)*running=ll_native_cache.player_count>0;
    int ok=ll_native_post(2,0,ll_native_default_player?ll_native_default_player(NULL):NULL);
